{
  "id": "346f8d7d-2975-49e0-b95b-f5d9da92bade",
  "label": "Extract Attributes Messy Data Suite",
  "modelType": "testSuite",
  "description": "",
  "testCases": [
    {
      "id": "e4c2fac3-bdf1-42a2-a3be-4c5e8ac2584a",
      "label": "Explicit CMS attribute wins over custom field and title",
      "input": {
        "product": {
          "id": "p1",
          "sku": "S1",
          "title": "Ryzen 7 7800X3D AM4",
          "categorySlug": "cpu",
          "customFields": [
            {
              "key": "socket",
              "value": "AM4"
            }
          ],
          "explicitAttributes": [
            {
              "key": "CPU Socket",
              "value": "Socket AM5"
            }
          ]
        }
      },
      "expectedOutput": {
        "socket": {
          "value": "AM5",
          "source": "explicit",
          "confidence": "high"
        },
        "unmappedAttributes": []
      }
    },
    {
      "id": "86a01a39-58a7-4a99-a5c2-054bd2dbe1b7",
