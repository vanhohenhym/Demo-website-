{
  "id": "137b7ea6-7547-48a3-9a94-5b36e7d0f7b4",
  "label": "Resolve Brand Messy Data Suite",
  "modelType": "testSuite",
  "description": "",
  "testCases": [
    {
      "id": "a8ff1008-1993-423a-b906-bdd25f11e3f0",
      "label": "Taxonomy brand wins and merges ASUSTeK alias to ASUS",
      "input": {
        "product": {
          "id": "b1",
          "sku": "S1",
          "title": "MSI B650 Motherboard",
          "categorySlug": "motherboard",
          "brandTaxonomy": "ASUSTeK"
        },
        "brandList": [
          {
            "name": "ASUS",
            "slug": "asus",
            "aliases": [
              "Asus",
              "ASUSTeK"
            ],
            "skuPrefixes": [
              "ASU-"
            ]
          }
        ]
      },
      "expectedOutput": {
        "brand": "ASUS",
        "brandSlug": "asus"
      }
    },
    {
      "id": "fd9b9aa9-0aea-4d5e-90b2-e70949b82148",
      "label": "Lowercase Brand attribute merges trimmed asus alias to ASUS",
      "input": {
        "product": {
          "id": "b2",
          "sku": "S2",
          "title": "Gaming RTX 4070",
          "categorySlug": "gpu",
          "explicitAttributes": [
            {
              "key": "brand",
              "value": "  asus  "
            }
          ]
        },
        "brandList": [
          {
            "name": "ASUS",
            "slug": "asus",
            "aliases": [
              "Asus",
              "ASUSTeK"
            ],
            "skuPrefixes": [
              "ASU-"
            ]
          }
        ]
      },
      "expectedOutput": {
        "brand": "ASUS",
        "brandSlug": "asus"
      }
    },
    {
