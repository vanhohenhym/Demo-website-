# Site URL (used for canonical URLs, sitemap, OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CMS Provider: mock | wp-posts | woocommerce | generic-rest
CMS_PROVIDER=mock
CMS_ENDPOINT=
CMS_KEY=
CMS_SECRET=

# Data Health Dashboard protection token
DATA_HEALTH_TOKEN=demo-health-token-secret

# Analytics & Search Console (GA4 loads only after Cookie Consent opt-in)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# Contact Form Email Transport (Precedence: Resend -> SMTP -> safe demo fallback)
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Optional sender override (falls back to SMTP_USER, then no-reply@example.com)
CONTACT_FROM_EMAIL=
CONTACT_RECEIVER_EMAIL=support@example.com
